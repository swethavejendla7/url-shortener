PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/shortener.sqlite
NODE_ENV=development
LOG_LEVEL=info

# Requests per window before a client is rate limited
RATE_LIMIT_CREATE_MAX=20
RATE_LIMIT_CREATE_WINDOW_MS=60000
RATE_LIMIT_REDIRECT_MAX=120
RATE_LIMIT_REDIRECT_WINDOW_MS=60000

# In-memory redirect cache
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=5000
